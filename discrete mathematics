#include <stdio.h>
#include <stdlib.h>
#include <time.h>

void generateGraph(int **adj, int n)
{
  int i, j;

  for (i = 0; i < n; i++)
  {
    for (j = 0; j < n; j++)
    {
      adj[i][j] = 0;
    }
  }

  for (i = 0; i < n; i++)
  {
    for (j = i + 1; j < n; j++)
    {
      if (rand() % 100 < 30)
      {
        adj[i][j] = 1;
        adj[j][i] = 1;
      }
    }
  }
}

int countEdges(int **adj, int n)
{
  int edge_count = 0;
  int i, j;

  for (i = 0; i < n; i++)
  {
    for (j = i + 1; j < n; j++)
    {
      if (adj[i][j] == 1)
        edge_count++;
    }
  }
  return edge_count;
}

void calculateDegrees(int **adj, int n, int *degrees)
{
  int i, j;

  for (i = 0; i < n; i++)
  {
    degrees[i] = 0;
    for (j = 0; j < n; j++)
    {
      if (adj[i][j] == 1)
        degrees[i]++;
    }
  }
}

int handshakingVerification(int *degrees, int n, int edges)
{
  int sum = 0;
  int i;

  for (i = 0; i < n; i++)
  {
    sum += degrees[i];
  }

  if (sum == 2 * edges)
    return 1;
  else
    return 0;
}

int main()
{
  int vertices[] = {1000, 2000, 3000, 4000, 5000};
  int num_experiments = 5;
  int i, experiment;

  printf("=========================================\n\n");

  for (experiment = 0; experiment < num_experiments; experiment++)
  {
    int n = vertices[experiment];

    printf("Testing with n = %d vertices:\n", n);

    int **adj = (int **)malloc(n * sizeof(int *));
    for (i = 0; i < n; i++)
    {
      adj[i] = (int *)malloc(n * sizeof(int));
    }

    int *degrees = (int *)malloc(n * sizeof(int));

    clock_t start = clock();

    generateGraph(adj, n);

    int total_edges = countEdges(adj, n);

    calculateDegrees(adj, n, degrees);

    int is_verified = handshakingVerification(degrees, n, total_edges);

    clock_t end = clock();

    double execution_time = ((double)(end - start)) / CLOCKS_PER_SEC * 1000.0;

    printf("Edge Count: %d\n", total_edges);
    printf("Verification of Handshaking Theorem: %s\n", is_verified ? "YES" : "NO");
    printf("Time to Compute: %.2f ms\n", execution_time);
    printf("--------------------------------\n");

    for (i = 0; i < n; i++)
    {
      free(adj[i]);
    }
    free(adj);
    free(degrees);
  }

  printf("\n=========================================\n");

  return 0;
}
